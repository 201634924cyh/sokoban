# 统一换行符策略，避免不同平台检出后脚本跑不起来。
# git 默认的 autocrlf 会把 .sh 转成 CRLF，导致 Linux/macOS 下报
# "bad interpreter: /bin/bash^M"，这里显式锁死。

# Shell 脚本必须是 LF，否则 Linux/macOS 下无法执行
*.sh            text eol=lf

# Windows 批处理必须是 CRLF
*.bat           text eol=crlf

# Python / 文本资料统一 LF（跨平台一致，Windows 下 Python 也能正常读）
*.py            text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
LICENSE         text eol=lf

# 预览图是二进制，禁止任何换行符处理
*.png           binary
